{
  "$comment": "Single source of truth for the build and publish pipeline. Read from bash via `node -p`.",
  "nodeApiVersion": "1.5.5-r.4",
  "duckdbVersion": "1.5.5",
  "compatibleRuntimes": ["nodejs22.x", "nodejs24.x"],
  "bundledExtensions": ["httpfs", "aws"],
  "flavors": {
    "base": { "layerNamePrefix": "duckdb-neo-nodejs" },
    "extensions": { "layerNamePrefix": "duckdb-neo-extensions-nodejs" }
  },
  "architectures": {
    "x86_64": {
      "npmCpu": "x64",
      "bindingsPackage": "@duckdb/node-bindings-linux-x64",
      "duckdbPlatform": "linux_amd64",
      "layerNameSuffix": "x86",
      "dockerPlatform": "linux/amd64",
      "runner": "ubuntu-latest"
    },
    "arm64": {
      "npmCpu": "arm64",
      "bindingsPackage": "@duckdb/node-bindings-linux-arm64",
      "duckdbPlatform": "linux_arm64",
      "layerNameSuffix": "arm64",
      "dockerPlatform": "linux/arm64",
      "runner": "ubuntu-24.04-arm"
    }
  }
}
